# The static demo needs none of these settings. Configure only for self-hosting.
DEMO_ONLY=true
# Local-only credentials. Use unique passwords when hosted.
POSTGRES_PASSWORD=lead_local_only
APP_DB_PASSWORD=runtime_local_only
QUEUE_DB_PASSWORD=queue_local_only
DATABASE_ADMIN_URL=postgresql://lead:lead_local_only@localhost:54329/lead
DATABASE_URL=postgresql://lead_runtime:runtime_local_only@localhost:54329/lead
QUEUE_DATABASE_URL=postgresql://lead_queue:queue_local_only@localhost:54329/lead
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Optional rotation: ENCRYPTION_KEYS is a JSON map of key versions to base64 keys.
# ENCRYPTION_KEY_VERSION=1
# ENCRYPTION_KEYS=
# HISTORY_RETENTION_DAYS=90
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PORT=3100
APP_ORIGIN=http://localhost:5173
EMBEDDED_WORKER=false
GROQ_MODEL=openai/gpt-oss-20b
# Optional host-approved OpenAI-compatible endpoint, including /v1 if required.
# Workspaces provide their own key and model in Connections. No operator key fallback.
# LLM_COMPATIBLE_BASE_URL=https://your-provider.example/v1
# For a trusted local HTTP endpoint only: LLM_ALLOW_LOCAL=true
WORKSPACE_DAILY_CALL_LIMIT=100
MAX_ACTIVE_JOBS=3
DATABASE_POOL_SIZE=4
REQUESTS_PER_MINUTE=600
# Only exact IPs/CIDRs of reverse proxies you control; empty trusts no proxy.
TRUSTED_PROXY_CIDRS=
